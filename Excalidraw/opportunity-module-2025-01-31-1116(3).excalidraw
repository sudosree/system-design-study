      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if the validation is successful then submit the request payload \nand an activity id is generated, this request goes to several downstream system\n       SLA to process activity id - 4 hrs\n          \n              \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
