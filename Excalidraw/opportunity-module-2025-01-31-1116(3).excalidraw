      "isDeleted": false,
      "boundElements": null,
      "updated": 1738314823264,
      "link": null,
      "locked": false,
      "text": "If the activity id is processed successfully then the items will be\nremoved from the dataset of FC Trapped Inventory table in BigQuery\nAnalyst will no longer consider those items \nAnd those items becomes available for sale on the walmart site",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the activity id is processed successfully then the items will be\nremoved from the dataset of FC Trapped Inventory table in BigQuery\nAnalyst will no longer consider those items \nAnd those items becomes available for sale on the walmart site",
